{
  "name": "classnest",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "班集（ClassNest）桌面应用",
  "license": "MIT",
  "main": "electron/main/main.js",
  "scripts": {
    "dev": "node student-frontend/dev-vite.js",
    "dev:new": "node student-frontend/dev-vite.js --vue36",
    "electron": "electron .",
    "electron:dev": "concurrently --names \"Vite,Electron\" --prefix-colors \"blue,green\" --kill-others \"node student-frontend/dev-vite.js\" \"electron .\"",
    "electron:dev36": "concurrently --names \"Vite3.6,Electron\" --prefix-colors \"magenta,green\" --kill-others \"node student-frontend/dev-vite.js --vue36\" \"electron .\"",
    "setup:vue36": "npm install --prefix student-frontend/vue36 --no-audit --no-fund",
    "inp": "node testjs/probe/inp-probe.mjs",
    "seed": "node testjs/tools/seed-test-data.js",
    "smoke": "node testjs/run-smoke.cjs",
    "test:units": "node testjs/run-units.js",
    "check:boundaries": "node testjs/tools/error-boundary-check.cjs",
    "check:boundaries:strict": "node testjs/tools/error-boundary-check.cjs --strict",
    "docs:verify": "node testjs/tools/docs-verify.mjs",
    "docs:sync": "node testjs/tools/docs-sync.mjs",
    "build": "cd student-frontend && npm run build",
    "build:new": "node student-frontend/dev-vite.js --vue36 build",
    "build:backend": "node student-backend/build.bundle.mjs",
    "build:win:inno": "node electron/inno/compile.mjs",
    "electron:build": "npm run build && npm run build:backend && electron-builder --dir && npm run build:win:inno",
    "electron:buildnew": "npm run build:new && npm run build:backend && electron-builder --dir --config.directories.output=release36 && npm run build:win:inno -- release36",
    "postinstall": "cd student-backend && npm install",
    "lint": "eslint student-frontend/src student-frontend/*.js student-backend electron",
    "test:behavior": "node testjs/run-behavior.js",
    "test": "node testjs/run-all.js --fast",
    "test:all": "node testjs/run-all.js"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "electron": "45.2.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "ui-ux-pro-max-cli": "^2.15.0",
    "wait-on": "^9.5.1"
  }
}
